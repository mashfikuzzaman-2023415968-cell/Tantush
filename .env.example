# ─── Domains ──────────────────────────────────────────────────────────
SHOP_DOMAIN=tantush.xyz
API_DOMAIN=api.tantush.xyz
# Public base URL that product images are served from (S3/R2 public URL if used)
MEDIA_URL=https://api.tantush.xyz

# ─── Database & cache (generated by infra/scripts/generate-secrets.sh) ─
POSTGRES_USER=tantush
POSTGRES_DB=tantush
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ─── Medusa secrets (≥ 48 chars, generated) ───────────────────────────
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Shared by storefront + backend to authorise guests viewing their own order
ORDER_ACCESS_SECRET=change-me

# Publishable key printed by the seed script (or Admin → Settings → Publishable API keys)
MEDUSA_PUBLISHABLE_KEY=pk_change_me

# ─── Shop contact shown on the website ───────────────────────────────
SHOP_PHONE=+880 1XXX-XXXXXX
SHOP_EMAIL=hello@tantush.xyz
FACEBOOK_URL=
INSTAGRAM_URL=
# Where new-order alerts go (phone for SMS provider / email)
SHOP_NOTIFY_TO=

# ─── Bot protection (Cloudflare → Turnstile → Add widget, free) ───────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Encrypts nightly database backups (keep a copy somewhere safe!)
BACKUP_PASSPHRASE=change-me

# ─── Business rules ──────────────────────────────────────────────────
COD_MAX_ORDER_TOTAL=50000
MAX_QTY_PER_LINE=10
LOW_STOCK_THRESHOLD=3

# ─── Scaling ─────────────────────────────────────────────────────────
MEDUSA_SERVER_REPLICAS=2
STOREFRONT_REPLICAS=2
BACKUP_RETENTION_DAYS=14

# ─── Optional: S3-compatible image storage (Oracle Object Storage / R2) ─
S3_BUCKET=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
