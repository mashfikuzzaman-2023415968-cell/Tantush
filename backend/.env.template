# Local development values. Production values come from the root .env via docker-compose.
NODE_ENV=development
DATABASE_URL=postgres://tantush:CHANGE_ME@localhost:5432/tantush
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=dev-only-replace-with-48+-random-characters-xxxxxxxxxxxxxxxx
COOKIE_SECRET=dev-only-replace-with-48+-random-characters-yyyyyyyyyyyyyyy
MEDUSA_BACKEND_URL=http://localhost:9000
# TRUST_PROXY=true only when running behind the bundled nginx
MEDUSA_DISABLE_TELEMETRY=true
# ORDER_ACCESS_SECRET= (generate: openssl rand -hex 32; same value in storefront)
STOREFRONT_URL=http://localhost:8000
# TURNSTILE_SECRET_KEY=   # enables bot checks on login/register/checkout
